---
CompileFlags:
    Add:
        - -ferror-limit=0

Index:
    Background: Skip

Diagnostics:
    ClangTidy:
        FastCheckFilter: None
    Includes:
        AnalyzeAngledIncludes: true

Completion:
    AllScopes: false
    ArgumentLists: Delimiters
    HeaderInsertion: Never

InlayHints:
    Enabled: false

Documentation:
    CommentFormat: Doxygen
