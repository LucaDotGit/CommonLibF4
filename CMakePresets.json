				"feature-clangd"
			],
			"displayName": "Configure Clangd Debug (Ninja)",
			"binaryDir": "${sourceDir}/build/clangd-ninja-debug"
		},
		{
			"name": "configure-clangd-ninja-release",
			"hidden": false,
