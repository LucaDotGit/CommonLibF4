			"binaryDir": "${sourceDir}/build/clangcl-ninja-release"
		},
		{
			"name": "configure-clangd-ninja-debug",
			"hidden": false,
			"inherits": [
				"configure-core",
				"toolchain-vcpkg",
				"intellisense-clangcl",
				"generator-ninja",
				"compiler-clangcl",
