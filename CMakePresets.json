{
	"$schema": "https://raw.githubusercontent.com/Kitware/CMake/refs/tags/v4.5.0/Help/manual/presets/schema.json",
	"version": 12,
	"cmakeMinimumRequired": {
		"major": 4,
		"minor": 5,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "configure-core",
			"hidden": true,
			"errors": {
				"deprecated": true
			},
			"warnings": {
				"author": true,
				"experimental": true,
				"installAbsoluteDestination": true,
				"policy": true,
				"unusedCli": true,
				"systemVars": true
			},
			"cacheVariables": {
				"CMAKE_CXX_STANDARD": "23",
				"CMAKE_CXX_STANDARD_REQUIRED": "TRUE",
				"CMAKE_CXX_EXTENSIONS": "FALSE"
			}
		},
		{
			"name": "toolchain-vcpkg",
			"hidden": true,
			"toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
		},
		{
			"name": "architecture-vs",
			"hidden": true,
			"architecture": {
				"strategy": "set",
				"value": "x64"
			},
			"cacheVariables": {
				"CMAKE_VS_WINDOWS_TARGET_PLATFORM_MIN_VERSION": "10.0.19045.0"
			}
		},
		{
			"name": "toolset-vs-msvc",
			"hidden": true,
			"toolset": {
				"strategy": "set",
				"value": "host=x64"
			}
		},
		{
			"name": "toolset-vs-clangcl",
			"hidden": true,
			"toolset": {
				"strategy": "set",
				"value": "ClangCL,host=x64"
			}
		},
		{
			"name": "intellisense-msvc",
			"hidden": true,
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"intelliSenseMode": "windows-msvc-x64",
					"enableMicrosoftCodeAnalysis": true,
					"enableClangTidyCodeAnalysis": true
				}
			}
		},
		{
			"name": "intellisense-clangcl",
			"hidden": true,
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"intelliSenseMode": "windows-clang-x64",
					"enableMicrosoftCodeAnalysis": false,
					"enableClangTidyCodeAnalysis": true
				}
			}
		},
		{
			"name": "generator-vs",
			"hidden": true,
			"generator": "Visual Studio 18 2026"
		},
		{
			"name": "generator-ninja",
			"hidden": true,
			"generator": "Ninja"
		},
		{
			"name": "compiler-msvc",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_CXX_COMPILER": "cl"
			}
		},
		{
			"name": "compiler-clangcl",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_CXX_COMPILER": "clang-cl"
			}
		},
		{
			"name": "buildtype-debug",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"VCPKG_HOST_TRIPLET": "x64-windows-static-md",
				"VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
				"CMAKE_OPTIMIZE_DEPENDENCIES": "FALSE"
			}
		},
		{
			"name": "buildtype-release",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"VCPKG_HOST_TRIPLET": "x64-windows-static-md-release",
				"VCPKG_TARGET_TRIPLET": "x64-windows-static-md-release",
				"CMAKE_OPTIMIZE_DEPENDENCIES": "TRUE"
			}
		},
		{
			"name": "feature-unity",
			"hidden": true,
			"condition": {
				"type": "equals",
				"lhs": "$env{COMMONLIB_FEATURE_UNITY_BUILD}",
				"rhs": "TRUE"
			},
			"cacheVariables": {
				"CMAKE_CXX_SCAN_FOR_MODULES": "FALSE",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "FALSE",
				"CMAKE_UNITY_BUILD": "TRUE",
				"CMAKE_UNITY_BUILD_BATCH_SIZE": "16",
				"CMAKE_UNITY_BUILD_RELOCATABLE": "TRUE"
			}
		},
		{
			"name": "feature-clangd",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
				"CMAKE_CXX_CLANG_TIDY": "clang-tidy"
			}
		},
		{
			"name": "configure-msvc-vs-debug",
			"hidden": false,
			"inherits": [
				"configure-core",
				"toolchain-vcpkg",
				"architecture-vs",
				"toolset-vs-msvc",
				"intellisense-msvc",
				"generator-vs",
				"compiler-msvc",
				"buildtype-debug",
				"feature-unity"
			],
