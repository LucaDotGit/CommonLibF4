				"generator-vs",
				"compiler-clangcl",
				"buildtype-release",
				"feature-unity"
			],
			"displayName": "Configure ClangCL Release (Visual Studio)",
			"binaryDir": "${sourceDir}/build/clangcl-vs-release"
		},
		{
			"name": "configure-msvc-ninja-debug",
			"hidden": false,
			"inherits": [
				"configure-core",
				"toolchain-vcpkg",
				"intellisense-msvc",
