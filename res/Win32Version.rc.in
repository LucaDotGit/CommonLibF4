#include <winres.h>

1 VERSIONINFO
	FILEVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, @PROJECT_VERSION_TWEAK@
	PRODUCTVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, @PROJECT_VERSION_TWEAK@
	FILEFLAGSMASK 0x17L
#if NDEBUG == 0
	FILEFLAGS 0x1L
#else
	FILEFLAGS 0x0L
#endif
	FILEOS 0x4L
	FILETYPE 0x1L
	FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "Comments", "@COMMONLIB_PLUGIN_COMMENTS@"
			VALUE "CompanyName", "@COMMONLIB_PLUGIN_AUTHOR@"
			VALUE "FileDescription", "@COMMONLIB_PLUGIN_DESCRIPTION@"
			VALUE "FileVersion", "@COMMONLIB_PLUGIN_VERSION@"
			VALUE "InternalName", "@COMMONLIB_PLUGIN_NAME@"
			VALUE "LegalCopyright", "Copyright (C) @COMMONLIB_PLUGIN_COPYRIGHT_YEAR@ @COMMONLIB_PLUGIN_AUTHOR@"
			VALUE "LegalTrademarks", "@COMMONLIB_PLUGIN_LICENSE@"
			VALUE "OriginalFilename", "@COMMONLIB_PLUGIN_NAME@@CMAKE_SHARED_LIBRARY_SUFFIX@"
			VALUE "ProductName", "@COMMONLIB_PLUGIN_NAME@"
			VALUE "ProductVersion", "@COMMONLIB_PLUGIN_VERSION@"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
